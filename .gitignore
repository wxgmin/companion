# ---- private data: NEVER commit ----
# Her voice, her chats, and anything derived from them stay on your machine.
data/voice/*
!data/voice/README.md
!data/voice/.gitkeep

data/persona/*
!data/persona/README.md
!data/persona/.gitkeep

data/sessions/
data/corpus/
data/whatsapp/
data/instagram/
data/_work/
data/_matrix/
*.wav
*.mp3
*.m4a
*.mp4
*.opus
*.flac
!data/**/README.md

# Screenshots of this machine. data/ is only partially ignored above, so these
# slipped into a commit once: they capture the whole desktop, including whatever
# happened to be on screen. Never publish them.
data/*.png
data/*.jpg
data/*.jpeg
!data/**/README.md

# ---- third-party projects: cloned by the user, never vendored ----
# Each has its own upstream and its own .git. setup.ps1 clones what it needs.
GPT-SoVITS/
Open-LLM-VTuber/
WeClone/
avatar-web/
qwen3-tts/
hermes-mcp/

# ---- local scratch ----
setup-logs/
logs/
AIRI_CONFIG.md
Modelfile.hermes*

# ---- secrets ----
.env
.env.*
*.key
auth.json
credentials.json

# ---- environments ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Vendored dependencies. tools/*/ installs its own on first run; committing them
# added ~350 files of C++ sources and prebuilt binaries to a repo that does not
# need to carry them.
node_modules/

# ---- per-machine state ----
# Marks that one-off setup already ran here, so it must not travel with a clone.
.configured

# ---- build and cache ----
build/
dist/
.cache/
*.log
*.err
*.out
logs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- editors and OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
